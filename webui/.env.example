REDIS_URL=redis://redis:6379/0
DEFAULT_TOOL_KEY=viddispatch
WEBUI_CONFIG_DIR=/scripts/webui-configs
WEBUI_SHARED_DEFAULTS_FILE=/scripts/webui-defaults/index.json
HOST_SCRIPTS_ROOT=M:/Server/LocalDev/VSCode/Scripts/vidematcher
CONTAINER_SCRIPTS_ROOT=/scripts
PATH_MOUNT_MAP=[{"host":"M:/p","container":"/p"},{"host":"Z:/","container":"/z"}]
POWERSHELL_EXE=pwsh
ALLOW_DESTRUCTIVE=false
RUN_TIMEOUT_SECONDS=21600
